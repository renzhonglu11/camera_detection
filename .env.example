# Deployment Configuration Example
# Copy this file to .env.local and update with your actual values
# .env.local should NOT be committed to git

# SSH target (hostname or user@host)
PI_HOST=your_pi_host_or_alias

# Remote deployment directory
REMOTE_DIR=/path/to/remote/deployment/bin

# Python Agent subproject (defaults to piAgent/ beside REMOTE_DIR)
# REMOTE_AGENT_DIR=/path/to/remote/deployment/piAgent
# uv version installed by deploy_agent.sh --bootstrap
AGENT_UV_VERSION=0.10.0

# Whether to run after deploy (set to 1 to enable)
RUN_AFTER=0

# Whether to use sudo when running (set to 1 to enable)
USE_SUDO=0
