#!/usr/bin/env bash
set -euo pipefail

if ! command -v file >/dev/null 2>&1; then
	echo "error: the 'file' command is required to verify staged files" >&2
	exit 1
fi

video_extension_pattern='^(mp4|m4v|mov|avi|mkv|webm|mpeg|mpg|wmv|flv|3gp|3g2|ogv|vob|h264|h265|hevc|mts|m2ts|mxf|y4m|asf|rm|rmvb)$'
blocked=0

while IFS= read -r -d '' path; do
	lower_path=${path,,}
	extension=${lower_path##*.}
	mime_type=$(git show ":${path}" | file --brief --mime-type -)

	if [[ "$extension" =~ $video_extension_pattern || "$mime_type" == video/* ]]; then
		echo "error: refusing to commit video file: $path ($mime_type)" >&2
		blocked=1
	fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if [[ "$blocked" -ne 0 ]]; then
	echo "Keep camera recordings and replay videos local; do not bypass this hook." >&2
	exit 1
fi
